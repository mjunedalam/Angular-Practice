/ActualText (from typing import Annotated\012from pydantic import Field\012from mcp\056server import MCPServer\012\012mcp \075 MCPServer\050\042observability\055demo\042\051\012SAMPLES \075 \173\042checkout\055api\042\072 \173\042p50\042\072 210\054 \042p95\042\072 1800\175\175\012\012\100mcp\056tool\050\051\012def query\137latency\050\012    service\072 str\054\012    window\137minutes\072 Annotated\133int\054 Field\050ge\0755\054 le\0751440\051\135 \075 60\054\012\051 \055\076 dict\072\012    \042\042\042Read synthetic latency values\073 not live production metrics\056\042\042\042\012    if service not in SAMPLES\072\012        raise ValueError\050\042service is not allowed\042\051\012    return \173\042service\042\072 service\054 \042window\137minutes\042\072 window\137minutes\054\012            \042quantiles\137ms\042\072 SAMPLES\133service\135\054 \042synthetic\042\072 True\175\012\012\100mcp\056resource\050\042runbook\072\057\057\173service\175\057latency\042\051\012def latency\137runbook\050service\072 str\051 \055\076 str\072\012    if service not in SAMPLES\072\012        raise ValueError\050\042service is not allowed\042\051\012    return \050\042Inspect current metrics and changes \042\012            \042before proposing action\056\042\051\012\012if \137\137name\137\137 \075\075 \042\137\137main\137\137\042\072\012    mcp\056run\050transport\075\042stdio\042\051)
