/ActualText (def resume\137compensation\050journal\054 executor\051\072\012    while \050step \072\075 journal\056next\137pending\137compensation\050\051\051 is not None\072\012        if step\056compensation is None\072\012            journal\056require\137manual\137recovery\050step\056id\051\012            return \173\042status\042\072 \042manual\137recovery\137required\042\175\012        journal\056record\137compensation\137intent\050step\056id\051\012        result \075 executor\056perform\137or\137reconcile\050\012            step\056compensation\054\012            operation\137id\075step\056compensation\137operation\137id\054\012        \051\012        if result\056status \075\075 \042unknown\042\072\012            journal\056record\137unknown\137compensation\050step\056id\051\012            return \173\042status\042\072 \042compensation\137pending\042\175\012        if result\056status \041\075 \042succeeded\042\072\012            journal\056record\137compensation\137failure\050step\056id\054 result\051\012            return \173\042status\042\072 \042manual\137recovery\137required\042\175\012        journal\056record\137compensated\050step\056id\054 result\051\012    return \173\042status\042\072 \042compensated\042\175)
>>
