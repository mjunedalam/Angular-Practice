/ActualText (import asyncio\012import json\012import sys\012from pathlib import Path\012from mcp import Client\054 StdioServerParameters\012\012async def inspect\137demo\050target\051\072\012    async with Client\050target\051 as client\072\012        catalog \075 await client\056list\137tools\050\051\012        names \075 \173tool\056name for tool in catalog\056tools\175\012        if \042query\137latency\042 not in names\072\012            raise ValueError\050\042required demo capability is absent\042\051\012        result \075 await asyncio\056wait\137for\050\012            client\056call\137tool\050\042query\137latency\042\054 \173\012                \042service\042\072 \042checkout\055api\042\054 \042window\137minutes\042\072 60\054\012            \175\051\054 timeout\0755\0560\054\012        \051\012        if result\056is\137error\072\012            raise RuntimeError\050\042demo tool reported an error\042\051\012        data \075 result\056structured\137content\012        if data is None\072\012            blocks \075 \133b\056text for b in result\056content\012                      if b\056type \075\075 \042text\042\135\012            if len\050blocks\051 \041\075 1\072\012                raise ValueError\050\042expected one JSON text block\042\051\012            data \075 json\056loads\050blocks\1330\135\051\012        if data\056get\050\042synthetic\042\051 is not True\072\012            raise ValueError\050\042expected the synthetic demo result\042\051\012        return data\012)
